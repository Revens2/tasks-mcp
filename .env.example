# Variables d'environnement de la stack tasks — DOCUMENTATION UNIQUEMENT.
# Le fichier réel (secrets/tasks.env, 0600, propriété tasks-app) est créé par
# scripts/bootstrap-caldav.sh et modifié par creer-compte-caldav.sh /
# rotation-jeton-tasks.sh / creer-phrase-consentement-tasks.sh. Jamais versionné.

# --- upstream tasks-mcp (service tasks-mcp.service) -------------------------
TASKS_CALDAV_URL=http://127.0.0.1:5232
TASKS_CALDAV_USER=example
TASKS_CALDAV_PASSWORD=          # secret : mot de passe du compte CalDAV
TASKS_DATA_DIR=/srv/tasks/data
TASKS_TRASH_LIST=Corbeille
TASKS_TRASH_RETENTION_DAYS=30
TASKS_UPSTREAM_PORT=8791

# --- passerelle tasks-gateway (service tasks-gateway.service) ---------------
TASKS_MCP_PORT=8792
TASKS_MCP_UPSTREAM=http://127.0.0.1:8791
TASKS_MCP_TOKEN=                # secret : jeton Bearer statique (clients CLI NetBird)
TASKS_MCP_TOKEN_SCOPES=tasks:lecture tasks:ecriture
TASKS_MCP_OAUTH_DIR=/srv/tasks/data/oauth
# Issuer OAuth : URL HTTPS publique FUTURE (phase 2 duckdns). Inerte en V1
# (réseau NetBird) ; à aligner sur l'URL réelle le jour de l'exposition publique.
TASKS_MCP_ISSUER=https://mcp.example.org
TASKS_MCP_CONSENT_HASH=         # secret : empreinte PBKDF2 de la phrase de consentement
